<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>12</LangVersion>
		<Nullable>enable</Nullable>
		<AssemblyName>TinyBVHNet.Raytracer.Cli</AssemblyName>
		<RootNamespace>TinyBVHNet.Raytracer.Cli</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TinyBVHNet.Raytracer\TinyBVHNet.Raytracer.csproj" />
	</ItemGroup>

	<!-- Copy native DLL to output -->
	<ItemGroup>
		<None Include="..\..\native\build\TinyBVHNetNative.dll" CopyToOutputDirectory="PreserveNewest" Link="TinyBVHNetNative.dll" />
	</ItemGroup>

</Project>
