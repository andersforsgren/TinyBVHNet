<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
		<PackageReference Include="xunit" Version="2.7.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TinyBVHNet\TinyBVHNet.csproj" />
	</ItemGroup>

	<!-- Copy native DLL/.so to test output so it's discoverable at runtime -->
	<ItemGroup>
		<None Include="..\..\build\TinyBVHNetNative.dll"
			  Condition="Exists('..\..\build\TinyBVHNetNative.dll')"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="TinyBVHNetNative.dll" />
		<None Include="..\..\build\TinyBVHNetNative-arm64.dll"
			  Condition="Exists('..\..\build\TinyBVHNetNative-arm64.dll')"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="TinyBVHNetNative.dll" />
		<None Include="..\..\build\libTinyBVHNetNative.so"
			  Condition="Exists('..\..\build\libTinyBVHNetNative.so')"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="libTinyBVHNetNative.so" />
		<None Include="..\..\build\libTinyBVHNetNative-arm64.so"
			  Condition="Exists('..\..\build\libTinyBVHNetNative-arm64.so')"
			  CopyToOutputDirectory="PreserveNewest"
			  Link="libTinyBVHNetNative.so" />
	</ItemGroup>

	<!-- net48 defaults to AnyCPU (x86), but native DLL is x64 -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!-- Force a version of System.Runtime.CompilerServices.Unsafe that satisfies both
	     System.Memory (>= 4.0.4.1) and xUnit (>= 6.0.0) on .NET Framework. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
	</ItemGroup>

</Project>
