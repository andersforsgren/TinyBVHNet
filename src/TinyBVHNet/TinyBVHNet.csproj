<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- NuGet package metadata -->
		<PackageId>TinyBVHNet</PackageId>
		<Authors>TinyBVHNet Contributors</Authors>
		<Description>.NET wrapper for the TinyBVH BVH construction and traversal library https://github.com/jbikker/tinybvh</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/andersforsgren/TinyBVHNet</RepositoryUrl>
		<PackageProjectUrl>https://github.com/andersforsgren/TinyBVHNet</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>BVH;ray-tracing;acceleration-structure;GPU</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<MinVerDefaultPreReleaseIdentifiers>preview.1</MinVerDefaultPreReleaseIdentifiers>
		<MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerVerbosity>normal</MinVerVerbosity>

		<!-- Platform support (for runtime pack resolution) -->
		<RuntimeIdentifiers>win-x64;linux-x64;osx-x64;win-arm64;linux-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Include README and native binaries in the NuGet package -->
	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="\" />
		<None Include="../../build/TinyBVHNetNative.dll" Condition="Exists('../../build/TinyBVHNetNative.dll')" Pack="true" PackagePath="runtimes/win-x64/native/TinyBVHNetNative.dll" />
		<None Include="../../build/TinyBVHNetNative-arm64.dll" Condition="Exists('../../build/TinyBVHNetNative-arm64.dll')" Pack="true" PackagePath="runtimes/win-arm64/native/TinyBVHNetNative.dll" />
		<None Include="../../build/libTinyBVHNetNative.so" Condition="Exists('../../build/libTinyBVHNetNative.so')" Pack="true" PackagePath="runtimes/linux-x64/native/libTinyBVHNetNative.so" />
		<None Include="../../build/libTinyBVHNetNative-arm64.so" Condition="Exists('../../build/libTinyBVHNetNative-arm64.so')" Pack="true" PackagePath="runtimes/linux-arm64/native/libTinyBVHNetNative.so" />
	</ItemGroup>

	<!-- MinVer: version from git tags -->
	<ItemGroup>
		<PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
	</ItemGroup>

	<!-- Include .targets file for native DLL deployment -->
	<ItemGroup>
		<None Include="build\TinyBVHNet.targets" Pack="true" PackagePath="build\net48\TinyBVHNet.targets" />
		<None Include="build\TinyBVHNet.targets" Pack="true" PackagePath="buildTransitive\net48\TinyBVHNet.targets" />
		<None Include="build\TinyBVHNet.targets" Pack="true" PackagePath="build\net8.0\TinyBVHNet.targets" />
		<None Include="build\TinyBVHNet.targets" Pack="true" PackagePath="buildTransitive\net8.0\TinyBVHNet.targets" />
	</ItemGroup>

</Project>
